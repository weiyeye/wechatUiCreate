{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "微信对话生成器",
  "version": "0.0.1",
  "identifier": "com.elecat.wechatdialoguegenerator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:9527",
    "beforeDevCommand": "yarn serve --host 127.0.0.1",
    "beforeBuildCommand": "yarn build"
  },
  "app": {
    "windows": [
      {
        "title": "微信对话生成器",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
